# Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Google Gemini / Veo (for AI video generation)
# GOOGLE_GEMINI_API_KEY=AIzaSy...

# ElevenLabs (hosted TTS — required by strategies using the `elevenlabs`
# backend, e.g. multi-character dialogue where cloning per speaker doesn't scale)
# ELEVENLABS_API_KEY=sk_...

# YouTube publishing (`shortform publish`). From a Google Cloud OAuth client
# of type "Desktop app", on a project with the YouTube Data API v3 enabled.
# YOUTUBE_CLIENT_ID=...apps.googleusercontent.com
# YOUTUBE_CLIENT_SECRET=...
# Written by `shortform publish-auth` — don't set this one by hand.
# YOUTUBE_REFRESH_TOKEN=

# Instagram (Phase 2)
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
